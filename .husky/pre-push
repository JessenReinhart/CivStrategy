#!/bin/sh

echo "Running full verification before push..."

# TypeScript type check
echo "1️⃣  TypeScript check..."
npx tsc --noEmit

# ESLint
echo "2️⃣  ESLint..."
npm run lint

# Tests
echo "3️⃣  Tests..."
npm run test

# Fallow dead-code detection (non-blocking, just log)
echo "4️⃣  Fallow dead-code detection..."
FALLOW_JSON=".fallow-report.json"
npx fallow dead-code --format json > "$FALLOW_JSON" 2>/dev/null
node scripts/fallow-summary.mjs "$FALLOW_JSON" || true
rm -f "$FALLOW_JSON"

echo ""
echo "✅ All checks passed! Pushing..."
