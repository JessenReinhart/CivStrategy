#!/bin/sh

echo "Running full verification before push..."

# TypeScript type check
echo "1️⃣  TypeScript check..."
npx tsc --noEmit

# ESLint
echo "2️⃣  ESLint..."
npm run lint

# Tests
echo "3️⃣  Tests..."
npm run test

# Fallow dead-code detection (non-blocking, just log)
echo "4️⃣  Fallow dead-code detection..."
npx fallow dead-code || true

echo ""
echo "✅ All checks passed! Pushing..."
